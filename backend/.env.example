# Server Configuration
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database
DATABASE_PATH=./data/talent-bridge.db

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY=your-api-key-for-client-authentication

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Mercor Configuration
MERCOR_EMAIL=turhanhamza@gmail.com
MERCOR_REFERRAL_CODE=your-referral-code-here

# Social Media APIs
# Twitter/X
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=@YourChannelName

# LinkedIn (if using automation tools)
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# Discord Webhooks
DISCORD_WEBHOOK_URL=your-discord-webhook-url

# Link Shortening
BITLY_ACCESS_TOKEN=your-bitly-access-token

# Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# External APIs
OPENAI_API_KEY=your-openai-api-key-for-content-generation

# Scheduling
CRON_JOB_ENABLED=true
AUTO_POST_ENABLED=false

# Notion Integration (optional)
NOTION_API_KEY=your-notion-api-key
NOTION_DATABASE_ID=your-notion-database-id
